---
const { d } = Astro.props;
---
<section class="seccion">
  <div class="contenedor">
    <div class="prosa">
      <h2>Para qué se usa</h2>
      <Fragment set:html={d.paraQue} />
    </div>
  </div>
</section>

<section class="seccion seccion--alt">
  <div class="contenedor">
    <div class="prosa">
      <h2>Qué modelos existen</h2>
      <Fragment set:html={d.modelos} />
    </div>
  </div>
</section>

<section class="seccion">
  <div class="contenedor">
    <div class="prosa">
      <h2>Qué tener en cuenta antes de comprar</h2>
      <Fragment set:html={d.tenerEnCuenta} />
    </div>
    <p class="seccion__cta">
      <a class="pildora" href="/contacto/">Pedir asesoramiento</a>
    </p>
  </div>
</section>
