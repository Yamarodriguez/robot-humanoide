---
import Base from '../../layouts/Base.astro';
import Relacionados from '../../components/Relacionados.astro';
import detalle from '../../data/marcas-detalle.json';
import grupo from '../../content/pages/marcas.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return Object.keys(detalle).filter((k) => !k.startsWith('_'))
    .map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const d = detalle[slug];
const tarjeta = grupo.html.match(
  new RegExp(`<article class="tarjeta" id="${slug}">([\\s\\S]*?)</article>`))?.[1] ?? '';
const imagen = tarjeta.match(/<img[^>]*src="([^"]+)"/)?.[1] ?? null;
const entradilla = (tarjeta.match(/<p>([\s\S]*?)<\/p>/)?.[1] ?? '').trim();

const pagina = {
  titulo: d.metaTitulo, url: `/marcas/${slug}/`, slug, h1: d.h1,
  entradilla, cta: null, hero: imagen, faq: [],
  metaTitulo: d.metaTitulo, metaDescripcion: d.metaDescripcion, imagenPrincipal: imagen,
};
const img = (r) => (site.baseImagenes && r ? site.baseImagenes + r : r);
---
<Base pagina={pagina} baseImagenes={site.baseImagenes}>
  <section class="seccion">
    <div class="contenedor">
      <div class="prosa"><h2>Qué es</h2><Fragment set:html={d.queEs} /></div>
    </div>
  </section>

  {(d.ficha || d.precio) && (
    <section class="seccion seccion--alt">
      <div class="contenedor">
        <div class="prosa"><h2>Ficha técnica y precio</h2></div>
        <div class="tabla-envoltorio">
          <table class="tabla">
            <tbody>
              {d.precio && (
                <>
                  <tr><th scope="row">Precio en origen</th><td>{d.precio.fabrica}</td></tr>
                  <tr><th scope="row">Precio en España</th><td>{d.precio.espana}</td></tr>
                  <tr><th scope="row">¿Se puede comprar?</th><td>{d.precio.disponible}</td></tr>
                  <tr><th scope="row">Plazo de entrega</th><td>{d.precio.entrega}</td></tr>
                </>
              )}
              {(d.ficha || []).map((f) => (
                <tr><th scope="row">{f[0]}</th><td>{f[1]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="tabla__nota">Datos de agosto de 2026. Confirma antes de decidir.</p>
      </div>
    </section>
  )}

  <section class="seccion">
    <div class="contenedor"><div class="prosa">
      <h2>Qué hace</h2><Fragment set:html={d.queHace} />
    </div></div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor"><div class="prosa">
      <h2>Para quién es</h2><Fragment set:html={d.paraQuien} />
    </div></div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="prosa">
        <h2>A tener en cuenta</h2><Fragment set:html={d.aTenerEnCuenta} />
      </div>
      <p class="seccion__cta"><a class="pildora" href="/contacto/">Pedir asesoramiento</a></p>
    </div>
  </section>

  <Relacionados grupoActual="/marcas/" slugActual={slug} />
</Base>
