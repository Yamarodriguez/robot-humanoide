---
import Base from '../../layouts/Base.astro';
import Relacionados from '../../components/Relacionados.astro';
import detalle from '../../data/tipos-detalle.json';
import indice from '../../data/indice-tarjetas.json';
import tipos from '../../content/pages/tipos.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  // Los slugs salen del archivo de detalle: no dependen de cómo esté
  // formada la URL en el índice, que cambia al crear estas páginas.
  return Object.keys(detalle)
    .filter((k) => !k.startsWith('_'))
    .map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props;
const d = detalle[slug];

// Los H2 llevan el nombre del tipo para que cada página sea específica.
// El h1 puede ser singular ("Robot Humanoide Industrial") o plural
// ("Robots Humanoides Médicos"); se ajusta el artículo según el caso.
const esPlural = d.h1.startsWith('Robots');
const tituloUso = esPlural
  ? `Para qué se usan los ${d.h1}`
  : `Para qué se usa un ${d.h1}`;
const tituloModelos = `Qué modelos de ${d.h1} existen`;
const tituloComprar = esPlural
  ? `Qué tener en cuenta antes de comprar ${d.h1}`
  : `Qué tener en cuenta antes de comprar un ${d.h1}`;

// La entradilla y la imagen se reutilizan de la tarjeta: son la misma pieza
const tarjeta = tipos.html.match(
  new RegExp(`<article class="tarjeta" id="${slug}">([\\s\\S]*?)</article>`)
)?.[1] ?? '';
const imagen = tarjeta.match(/<img[^>]*src="([^"]+)"/)?.[1] ?? null;
const entradilla = (tarjeta.match(/<p>([\s\S]*?)<\/p>/)?.[1] ?? '').trim();

const hermanos = (indice['/tipos/'] || [])
  .filter((t) => !t.url.includes(slug))
  .map((t) => ({ texto: t.texto, url: t.url }));

const pagina = {
  titulo: d.metaTitulo, url: `/tipos/${slug}/`, slug,
  h1: d.h1, entradilla, cta: null, hero: imagen, faq: [],
  metaTitulo: d.metaTitulo, metaDescripcion: d.metaDescripcion,
  imagenPrincipal: imagen,
};
const img = (r) => (site.baseImagenes && r ? site.baseImagenes + r : r);
---
<Base pagina={pagina} baseImagenes={site.baseImagenes}>
  <section class="seccion">
    <div class="contenedor">
      <div class="prosa">
        <h2>{tituloUso}</h2>
        <Fragment set:html={d.paraQue} />
      </div>
    </div>
  </section>

  <section class="seccion seccion--alt">
    <div class="contenedor">
      <div class="prosa">
        <h2>{tituloModelos}</h2>
        <Fragment set:html={d.modelos} />
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="prosa">
        <h2>{tituloComprar}</h2>
        <Fragment set:html={d.tenerEnCuenta} />
      </div>
      <p class="seccion__cta">
        <a class="pildora" href="/contacto/">Pedir asesoramiento</a>
      </p>
    </div>
  </section>

  <Relacionados grupoActual="/tipos/" slugActual={slug} />
</Base>
