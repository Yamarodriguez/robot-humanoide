---
import Base from '../layouts/Base.astro';
import legales from '../data/legales.json';
import site from '../data/site.json';

const d = legales['gracias'];
const pagina = { ...d, url: '/gracias/', slug: 'gracias', titulo: d.metaTitulo,
                 entradilla: '', cta: null, hero: null, faq: [], imagenPrincipal: null };
---
<Base pagina={pagina} baseImagenes={site.baseImagenes}>
  <Fragment set:html={pagina.html} />
</Base>
